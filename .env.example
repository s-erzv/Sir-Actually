# Copy to .env.local and fill in. Never commit real keys.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (server only) ------------------------------------------------------
# anthropic | openai | gemini | kagiro (OpenAI-compatible)
LLM_PROVIDER=kagiro
LLM_API_KEY=
LLM_MODEL=glm-5-3-flash
# LLM_BASE_URL=
# Reading the manuscript and judging default to the fast model (glm-5-3-flash).
# LLM_MODEL_ANALYSIS=
# LLM_MODEL_JUDGE=
# Per-monster override, e.g. LLM_MODEL_ELDRAVOS=...
# Parallel LLM requests per server process. Lower it if the provider returns 429.
# LLM_MAX_CONCURRENCY=4
# LLM_MAX_OUTPUT_TOKENS=4096
# Daily token ceiling across all users; unset = no ceiling.
# LLM_DAILY_TOKEN_BUDGET=

# --- Embeddings (optional; retrieval falls back to full-text search) --------
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=768
